<div class="mx-auto flex min-h-dvh w-full max-w-[430px] flex-col bg-white sm:my-6 sm:min-h-[calc(100dvh-3rem)] sm:overflow-hidden sm:rounded-[32px] sm:border sm:border-neutral-200 sm:shadow-q200">
  <div class="pointer-events-none fixed inset-x-0 top-3 z-50 mx-auto flex max-w-[430px] flex-col gap-2 px-4 [&>*]:pointer-events-auto">
    <.flash_group flash={@flash} />
  </div>
  {@inner_content}
</div>
