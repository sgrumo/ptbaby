<div class="flex min-h-dvh bg-white">
  <aside class="sticky top-0 flex h-dvh w-60 shrink-0 flex-col gap-8 border-r border-neutral-200 bg-neutral-50 px-4 py-6">
    <.link
      navigate={~p"/admin"}
      class="ml-2 font-display text-[22px] font-semibold leading-6 tracking-[-0.01em] text-primary-600"
    >
      Work Baby
    </.link>
    <nav class="flex flex-col gap-1" aria-label="Console">
      <.nav_link navigate={~p"/admin"} icon="hero-user-group" active={assigns[:nav] == :clients}>
        Clienti
      </.nav_link>
      <.nav_link
        navigate={~p"/admin/programs"}
        icon="hero-clipboard-document-list"
        active={assigns[:nav] == :programs}
      >
        Programmi
      </.nav_link>
      <.nav_link
        navigate={~p"/admin/templates"}
        icon="hero-square-3-stack-3d"
        active={assigns[:nav] == :templates}
      >
        Template
      </.nav_link>
    </nav>
    <div class="flex-1"></div>
    <div class="flex items-center gap-2.5 p-2">
      <.avatar name={@current_user.name} tone={:dark} class="h-9 w-9 text-[13px]" />
      <div class="flex min-w-0 flex-col">
        <span class="truncate text-sm font-semibold">{@current_user.name}</span>
        <span class="text-xs text-neutral-500">Personal trainer</span>
      </div>
      <.link
        href={~p"/sign-out"}
        method="delete"
        aria-label="Esci"
        title="Esci"
        class="ml-auto flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-neutral-500 hover:bg-neutral-100 hover:text-neutral-800"
      >
        <.icon name="hero-arrow-right-on-rectangle" class="h-[18px] w-[18px]" />
      </.link>
    </div>
  </aside>

  <div class="flex min-w-0 flex-1 flex-col">
    <div class="pointer-events-none fixed right-6 top-4 z-50 flex w-96 flex-col gap-2 [&>*]:pointer-events-auto">
      <.flash_group flash={@flash} />
    </div>
    {@inner_content}
  </div>
</div>
